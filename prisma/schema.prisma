generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum DocumentStatus {
 DRAFT
 OPEN
 APPROVED
 PARTIAL
 RECEIVED
 CANCELLED
}
enum PaymentStatus {
 UNPAID
 PARTIAL
 PAID
 REFUNDED
}
enum MovementType {
 PURCHASE
 SALE
 PURCHASE_RETURN
 SALES_RETURN
 ADJUSTMENT
 TRANSFER_IN
 TRANSFER_OUT
 OPENING
}
enum UserRole {
 OWNER
 ADMIN
 MANAGER
 INVENTORY
 STAFF
 ACCOUNTANT
}
model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 role UserRole @default(STAFF)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 auditLogs AuditLog[]
}
model Category {
 id String @id @default(cuid())
 name String @unique
 description String?
 products Product[]
 createdAt DateTime @default(now())
}
model Brand {
 id String @id @default(cuid())
 name String @unique
 products Product[]
}
model Unit {
 id String @id @default(cuid())
 name String
 symbol String @unique
 products Product[]
}
model Product {
 id String @id @default(cuid())
 sku String @unique
 barcode String? @unique
 name String
 description String?
 categoryId String?
 category Category? @relation(fields:[categoryId],references:[id])
 brandId String?
 brand Brand? @relation(fields:[brandId],references:[id])
 unitId String?
 unit Unit? @relation(fields:[unitId],references:[id])
 hsnCode String?
 gstRate Decimal @default(0) @db.Decimal(5,2)
 costPrice Decimal @default(0) @db.Decimal(12,2)
 sellingPrice Decimal @default(0) @db.Decimal(12,2)
 mrp Decimal @default(0) @db.Decimal(12,2)
 reorderLevel Decimal @default(0) @db.Decimal(12,3)
 trackBatch Boolean @default(true)
 trackExpiry Boolean @default(true)
 active Boolean @default(true)
 batches Batch[]
 stockBalances StockBalance[]
 movements StockMovement[]
 purchaseItems PurchaseItem[]
 saleItems SaleItem[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([name])
 @@index([categoryId])
}
model Warehouse {
 id String @id @default(cuid())
 name String
 code String @unique
 address String?
 active Boolean @default(true)
 balances StockBalance[]
 movements StockMovement[]
}
model Batch {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id])
 batchNumber String
 manufacturingDate DateTime?
 expiryDate DateTime?
 costPrice Decimal @default(0) @db.Decimal(12,2)
 balances StockBalance[]
 movements StockMovement[]
 purchaseItems PurchaseItem[]
 saleItems SaleItem[]
 @@unique([productId,batchNumber])
 @@index([expiryDate])
}
model StockBalance {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id])
 warehouseId String
 warehouse Warehouse @relation(fields:[warehouseId],references:[id])
 batchId String?
 batch Batch? @relation(fields:[batchId],references:[id])
 quantity Decimal @default(0) @db.Decimal(14,3)
 updatedAt DateTime @updatedAt
 @@unique([productId,warehouseId,batchId])
 @@index([warehouseId,productId])
}
model StockMovement {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id])
 warehouseId String
 warehouse Warehouse @relation(fields:[warehouseId],references:[id])
 batchId String?
 batch Batch? @relation(fields:[batchId],references:[id])
 type MovementType
 quantity Decimal @db.Decimal(14,3)
 unitCost Decimal? @db.Decimal(12,2)
 referenceType String?
 referenceId String?
 notes String?
 createdBy String?
 createdAt DateTime @default(now())
 @@index([productId,createdAt])
 @@index([referenceType,referenceId])
}
model Supplier {
 id String @id @default(cuid())
 name String
 code String? @unique
 gstin String?
 phone String?
 email String?
 address String?
 openingBalance Decimal @default(0) @db.Decimal(12,2)
 purchases Purchase[]
 createdAt DateTime @default(now())
}
model Customer {
 id String @id @default(cuid())
 name String
 phone String?
 email String?
 gstin String?
 billingAddress String?
 shippingAddress String?
 openingBalance Decimal @default(0) @db.Decimal(12,2)
 sales Sale[]
 createdAt DateTime @default(now())
}
model Purchase {
 id String @id @default(cuid())
 number String @unique
 supplierId String
 supplier Supplier @relation(fields:[supplierId],references:[id])
 status DocumentStatus @default(DRAFT)
 paymentStatus PaymentStatus @default(UNPAID)
 invoiceDate DateTime @default(now())
 dueDate DateTime?
 subtotal Decimal @default(0) @db.Decimal(12,2)
 discount Decimal @default(0) @db.Decimal(12,2)
 taxTotal Decimal @default(0) @db.Decimal(12,2)
 grandTotal Decimal @default(0) @db.Decimal(12,2)
 paidAmount Decimal @default(0) @db.Decimal(12,2)
 notes String?
 items PurchaseItem[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model PurchaseItem {
 id String @id @default(cuid())
 purchaseId String
 purchase Purchase @relation(fields:[purchaseId],references:[id],onDelete:Cascade)
 productId String
 product Product @relation(fields:[productId],references:[id])
 batchId String?
 batch Batch? @relation(fields:[batchId],references:[id])
 batchNumber String?
 expiryDate DateTime?
 quantity Decimal @db.Decimal(14,3)
 receivedQuantity Decimal @default(0) @db.Decimal(14,3)
 unitCost Decimal @db.Decimal(12,2)
 discount Decimal @default(0) @db.Decimal(12,2)
 taxRate Decimal @default(0) @db.Decimal(5,2)
 lineTotal Decimal @db.Decimal(12,2)
}
model Sale {
 id String @id @default(cuid())
 number String @unique
 customerId String?
 customer Customer? @relation(fields:[customerId],references:[id])
 status DocumentStatus @default(DRAFT)
 paymentStatus PaymentStatus @default(UNPAID)
 invoiceDate DateTime @default(now())
 dueDate DateTime?
 subtotal Decimal @default(0) @db.Decimal(12,2)
 discount Decimal @default(0) @db.Decimal(12,2)
 taxTotal Decimal @default(0) @db.Decimal(12,2)
 grandTotal Decimal @default(0) @db.Decimal(12,2)
 paidAmount Decimal @default(0) @db.Decimal(12,2)
 notes String?
 items SaleItem[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model SaleItem {
 id String @id @default(cuid())
 saleId String
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Cascade)
 productId String
 product Product @relation(fields:[productId],references:[id])
 batchId String?
 batch Batch? @relation(fields:[batchId],references:[id])
 quantity Decimal @db.Decimal(14,3)
 unitPrice Decimal @db.Decimal(12,2)
 discount Decimal @default(0) @db.Decimal(12,2)
 taxRate Decimal @default(0) @db.Decimal(5,2)
 lineTotal Decimal @db.Decimal(12,2)
}
model StockTransfer {
 id String @id @default(cuid())
 number String @unique
 fromWarehouseId String
 toWarehouseId String
 status DocumentStatus @default(DRAFT)
 notes String?
 createdAt DateTime @default(now())
 items StockTransferItem[]
}
model StockTransferItem {
 id String @id @default(cuid())
 transferId String
 transfer StockTransfer @relation(fields:[transferId],references:[id],onDelete:Cascade)
 productId String
 batchId String?
 quantity Decimal @db.Decimal(14,3)
}
model StockAdjustment {
 id String @id @default(cuid())
 number String @unique
 warehouseId String
 reason String
 notes String?
 createdAt DateTime @default(now())
 items StockAdjustmentItem[]
}
model StockAdjustmentItem {
 id String @id @default(cuid())
 adjustmentId String
 adjustment StockAdjustment @relation(fields:[adjustmentId],references:[id],onDelete:Cascade)
 productId String
 batchId String?
 systemQuantity Decimal @db.Decimal(14,3)
 countedQuantity Decimal @db.Decimal(14,3)
 difference Decimal @db.Decimal(14,3)
}
model Expense {
 id String @id @default(cuid())
 number String @unique
 category String
 description String?
 amount Decimal @db.Decimal(12,2)
 date DateTime @default(now())
 paymentMethod String?
 createdAt DateTime @default(now())
}
model Payment {
 id String @id @default(cuid())
 direction String
 partyType String
 partyId String?
 referenceType String?
 referenceId String?
 amount Decimal @db.Decimal(12,2)
 method String
 transactionDate DateTime @default(now())
 referenceNumber String?
 notes String?
 createdAt DateTime @default(now())
}
model AuditLog {
 id String @id @default(cuid())
 userId String?
 user User? @relation(fields:[userId],references:[id])
 action String
 entity String
 entityId String?
 before Json?
 after Json?
 ipAddress String?
 createdAt DateTime @default(now())
 @@index([entity,entityId])
 @@index([createdAt])
}
